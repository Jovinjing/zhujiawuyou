    <sql id="Base_Column_List">
        picture.*, user.user_name
    </sql>
    <select id="selectById" resultType="com.example.entity.Picture">
        select
        <include refid="Base_Column_List" />
        from picture
        INNER JOIN user ON picture.user_id = user.id
        <where>
            <if test="id != null"> and picture.id= #{id}</if>
        </where>
    </select>
    <select id="selectPageAll" resultType="com.example.entity.Picture">
        select
        <include refid="Base_Column_List" />
        from picture
        INNER JOIN user ON picture.user_id = user.id
        <where>
            <if test="userName != null"> and user.user_name like concat('%',#{key},'%')</if>
        </where>

    </select>
